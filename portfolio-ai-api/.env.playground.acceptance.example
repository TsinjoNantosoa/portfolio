ENVIRONMENT=production
PUBLIC_SITE_URL=https://deploy-preview.example.netlify.app
ALLOWED_ORIGINS=https://deploy-preview.example.netlify.app
TRUST_PROXY_HEADERS=true
TRUSTED_PROXY_PROVIDER=render
SESSION_SECRET=replace-with-a-random-value-of-at-least-32-characters
OPENAI_API_KEY=replace-in-the-isolated-environment-only
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_MAX_OUTPUT_TOKENS=300
OPENAI_TIMEOUT_SECONDS=60
QDRANT_URL=https://replace-with-isolated-qdrant-endpoint
QDRANT_API_KEY=replace-in-the-isolated-environment-only
QDRANT_COLLECTION=portfolio_knowledge_acceptance
RAG_TOP_K=4
RETRIEVAL_SCORE_THRESHOLD=0.20
PLAYGROUND_ENABLED=true
PLAYGROUND_MAX_INPUT_CHARS=400
PLAYGROUND_SESSION_RATE_LIMIT_PER_HOUR=6
PLAYGROUND_IP_RATE_LIMIT_PER_HOUR=8
PLAYGROUND_GLOBAL_RATE_LIMIT_PER_HOUR=12
PLAYGROUND_MAX_CONCURRENT_REQUESTS=1
PLAYGROUND_MAX_OUTPUT_TOKENS=300
PLAYGROUND_INSTANCE_COUNT=1
PLAYGROUND_REQUEST_TIMEOUT_SECONDS=70
CORPUS_READINESS_TTL_SECONDS=0
OPERATIONS_MONITOR_ENABLED=false
OPERATIONS_RETENTION_HOURS=24
OPERATIONS_MAX_EVENTS=5000
OPERATIONS_STALE_AFTER_MINUTES=15
OPERATIONS_CACHE_SECONDS=30
OPERATIONS_RATE_LIMIT_PER_MINUTE=30
